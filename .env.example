# 伺服器 Port（單一入口）
PORT=9090
# 資料庫：sqlite 或 mssql
DB_DIALECT=sqlite
# SQLite 檔案路徑（相對 server/）
SQLITE_STORAGE=data/hisp.sqlite
# SQL Server 2022 連線（DB_DIALECT=mssql 時使用）
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Session 有效時數
SESSION_TTL_HOURS=8
# 以 HTTPS 部署時設為 true
COOKIE_SECURE=false
# 登入失敗回應最短延遲（毫秒）
LOGIN_MIN_DELAY_MS=1500
# 每 IP 每 15 分鐘登入嘗試上限
LOGIN_RATE_LIMIT=10
# 反向代理層數（放在 IIS/nginx 後方時設 1；0 = 不信任 X-Forwarded-For）
TRUST_PROXY=0

# ── 校內帳號驗證（portal API） ──
# REST 端點（向管理者索取）
PORTAL_AUTH_URL=
# API 金鑰（X-Auth-Key，機密，請自行填入；勿寫入前端）
PORTAL_API_KEY=
# 呼叫逾時（毫秒）
PORTAL_TIMEOUT_MS=8000
# 啟動時自動確保為管理者的帳號（逗號分隔）
BOOTSTRAP_ADMINS=
# 驗證碼有效秒數
CAPTCHA_TTL_SECONDS=120
# 每 IP 每分鐘取驗證碼上限
CAPTCHA_RATE_LIMIT=30